    desc_sno: int32;
    stage_limit: int32;
    content_unlock_storyno: int32;
    battle_ticket_item: int32;
    item_infosOffset: string;
    event_shop_noOffset: string;
    date_type: int32;
    magic_valueOffset: string;
    ui_pathOffset: string;
    banner_pathOffset: string;
    title_pathOffset: string;
