namespace Tbl;

table Soullink {
  no: int32;
  collection: int32;
  group__slot: string;
  group__content: string;
  group__hero1: int32;
  group__hero2: int32;
  group__hero3: int32;
  group__hero4: int32;
  group__title: int32;
  group__story: int32;
  open_date: string;
}

table SoullinkTable {
  soullinks: [Soullink];
}

root_type SoullinkTable;
