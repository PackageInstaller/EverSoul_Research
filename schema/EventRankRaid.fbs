namespace EventRankRaid;

table Deserialization {
    no: int32;
    event_group: int32;
    event_number: int32;
    stage_no: int32;
    battle_view_type: int32;
    help_desc_sno: int32;
    challenge_no1: int32;
    challenge_bonus1: float;
    challenge_no2: int32;
    challenge_bonus2: float;
    challenge_no3: int32;
    challenge_bonus3: float;
    bg_path: string;
    bg_position: string;
    event_bg_path: string;
    sound_path: string;
    open_date: string;
}

table EventRankRaid {
    json: [Deserialization];
}

root_type EventRankRaid;
