namespace Achievement;

table Deserialization {
    no: int32;
    group: int32;
    category: int32;
    sub_category: int32;
    behavior: int32;
    value: int64;
    item_no1: int32;
    amount1: int32;
    item_no2: int32;
    amount2: int32;
    item_no3: int32;
    amount3: int32;
    content_string_sno: int32;
    require_type: int32;
    hero_reward: int32;
}

table Achievement {
    json: [Deserialization];
}

root_type Achievement;
