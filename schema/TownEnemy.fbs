namespace TownEnemy;

table Deserialization {
    no: int32;
    prefab_pathOffset: string;
    slotOffset: string;
    type: int32;
    movedelay: float;
    movetime: float;
    movespeed: int32;
    avoiddelay: float;
    avoidtime: float;
    avoidspeed: int32;
    atk: int32;
    hp: int32;
    rewardOffset: string;
    rewardgroup: int32;
    appear_ratio: int32;
    section: int32;
}

table TownEnemy {
    json: [Deserialization];
}

root_type TownEnemy;
