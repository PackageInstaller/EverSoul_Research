namespace Tbl;

table EventDefenseItem {
  no: int32;
  item_prefab: string;
  item_type: int32;
  item_value: float;
  fx: string;
  duration: int32;
  random_rate: int32;
  count_string: int32;
}

table EventDefenseItemTable {
  event_defense_items: [EventDefenseItem];
}

root_type EventDefenseItemTable;
