namespace EventDiceReward;

table Deserialization {
    no: int32;
    reward_group: int32;
    reward_type: int32;
    is_repeat: int32;
    reward_value: int32;
    reward_item_no1: int32;
    reward_item_amount1: int32;
    reward_item_no2: int32;
    reward_item_amount2: int32;
    reward_item_no3: int32;
    reward_item_amount3: int32;
}

table EventDiceReward {
    json: [Deserialization];
}

root_type EventDiceReward;
