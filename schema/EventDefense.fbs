namespace EventDefense;

table Deserialization {
    no: int32;
    event_group: int32;
    game_type: int32;
    stage_name_sno: int32;
    mission_sno: int32;
    bg_pathOffset: string;
    sound_pathOffset: string;
    playable_hero_no: int32;
    vehicle_prefabOffset: string;
    transformation_hero_no: int32;
    transformation_setting_no: int32;
    camera_setting_no: int32;
    playtime: int32;
    limit_value: int32;
    is_additional_enter: int32;
    additional_enter_priceOffset: string;
    limit_sno: int32;
    mapOffset: string;
}

table EventDefense {
    json: [Deserialization];
}

root_type EventDefense;
